# Copy this file to `.env` and fill in real values.
# `.env` is gitignored and must never be committed.
#
#   cp .env.example .env      (macOS/Linux)
#   copy .env.example .env    (Windows)
#
# NOTE: no real patient data is used anywhere in this project. Every document
# in data/samples is synthetic and generated by data/generator.

# ---------------------------------------------------------------------------
# 1. Test mailbox (IMAP)
# ---------------------------------------------------------------------------
# Use a THROWAWAY Gmail account created only for this assignment.
#
# Setup:
#   1. Create a new Gmail account (nothing personal on it).
#   2. Google Account -> Security -> turn ON 2-Step Verification.
#      (App passwords are hidden until 2FA is enabled.)
#   3. Google Account -> Security -> App passwords -> generate one for "Mail".
#   4. Paste the 16-character password below, spaces removed.
#
# The same address and App Password are used for SMTP by
# `manage.py send_samples`, which posts the synthetic corpus into this mailbox
# so the real IMAP path can be tested with genuine attachments.
#
# The app polls this mailbox read-only and never deletes mail.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your-test-account@gmail.com
IMAP_PASSWORD=your16charapppassword
IMAP_FOLDER=INBOX
# IMAP search expression. Leave BLANK to use the safe default, which matches
# only messages generated by this project (they carry an X-Synthetic-Case-Id
# header). Set to ALL only for a genuinely empty throwaway account -- pointing
# ALL at a mailbox with real mail would send that mail to a cloud LLM.
IMAP_SEARCH=
# Poll interval in seconds for the backend mail poller.
IMAP_POLL_SECONDS=60
# When true the poller is skipped entirely and documents are read from
# data/samples instead -- used by tests and for an offline demo.
MAIL_OFFLINE_MODE=false

# ---------------------------------------------------------------------------
# 2. AI model
# ---------------------------------------------------------------------------
# Gemini is the default: vision-capable (needed for scanned/handwritten PDFs
# and image descriptions), cheap, and has a usable free tier.
GEMINI_API_KEY=
LLM_MODEL=gemini-2.0-flash
# Vision model for scanned pages, handwriting and embedded images.
VISION_MODEL=gemini-2.0-flash
# Optional fallbacks -- leave blank to disable.
GROQ_API_KEY=
MISTRAL_API_KEY=

# ---------------------------------------------------------------------------
# 3. Oracle database
# ---------------------------------------------------------------------------
# Defaults match docker-compose.yml -- change only if you edit that file.
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE=FREEPDB1
ORACLE_USER=smartinbox
ORACLE_PASSWORD=change_me_locally
# Password for the container's SYS/SYSTEM accounts.
ORACLE_ADMIN_PASSWORD=change_me_locally

# ---------------------------------------------------------------------------
# 4. Service wiring
# ---------------------------------------------------------------------------
AI_SERVICE_URL=http://localhost:8000
BACKEND_URL=http://localhost:8080
FRONTEND_URL=http://localhost:4200
